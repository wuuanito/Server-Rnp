# ==============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================
# Copia este archivo como .env y ajusta los valores según tu entorno

# ==============================================
# AUTH SERVICE CONFIGURATION
# ==============================================
AUTH_NODE_ENV=production
AUTH_PORT=4001
AUTH_DB_HOST=mysql-auth
AUTH_DB_PORT=3306
AUTH_DB_USER=root
AUTH_DB_PASSWORD=root
AUTH_DB_NAME=auth_service_db
AUTH_JWT_SECRET=your_jwt_secret_key_should_be_long_and_secure_change_this_in_production
AUTH_JWT_EXPIRES_IN=24h

# ==============================================
# CREMER BACKEND CONFIGURATION
# ==============================================
CREMER_NODE_ENV=production
CREMER_PORT=3002
CREMER_DB_HOST=mysql-cremer
CREMER_DB_USER=root
CREMER_DB_PASS=root
CREMER_DB_NAME=cremer

# ==============================================
# TECNOMACO BACKEND CONFIGURATION
# ==============================================
TECNOMACO_NODE_ENV=production
TECNOMACO_PORT=3005
TECNOMACO_DB_HOST=mysql-tecnomaco
TECNOMACO_DB_USER=root
TECNOMACO_DB_PASS=root
TECNOMACO_DB_NAME=tecnomaco

# ==============================================
# SERVIDOR RPS CONFIGURATION
# ==============================================
RPS_NODE_ENV=production
RPS_PORT=4000
# Configuración SQL Server externa
RPS_SQL_SERVER=192.168.11.2
RPS_SQL_USER=rpsuser
RPS_SQL_PASSWORD=rpsnext
RPS_SQL_DATABASE=RpsNext

# ==============================================
# MYSQL DATABASES CONFIGURATION
# ==============================================
# Auth Service Database
MYSQL_AUTH_ROOT_PASSWORD=Root123!
MYSQL_AUTH_DATABASE=auth_service_db
MYSQL_AUTH_USER=naturepharma
MYSQL_AUTH_PASSWORD=Root123!

# Cremer Database
MYSQL_CREMER_ROOT_PASSWORD=root
MYSQL_CREMER_DATABASE=cremer

# Tecnomaco Database
MYSQL_TECNOMACO_ROOT_PASSWORD=root
MYSQL_TECNOMACO_DATABASE=tecnomaco

# ==============================================
# NGINX CONFIGURATION
# ==============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==============================================
# DOCKER NETWORK CONFIGURATION
# ==============================================
DOCKER_NETWORK_SUBNET=172.20.0.0/16

# ==============================================
# EXTERNAL SERVICES
# ==============================================
# SQL Server externo (mantener configuración original)
EXTERNAL_SQL_SERVER_HOST=192.168.11.2
EXTERNAL_SQL_SERVER_PORT=1433

# ==============================================
# SECURITY NOTES
# ==============================================
# IMPORTANTE: 
# - Cambia todas las contraseñas por defecto en producción
# - Genera un JWT_SECRET seguro y único
# - Considera usar Docker Secrets para información sensible
# - Revisa las configuraciones de red según tu infraestructura